# MySQL Server 9.x enables GTIDs by default, while 8.0 and 8.4 do not. Tests
# that need GTIDs enable them explicitly (via .combinations or -master.opt
# files, which take precedence over this file), so here GTIDs are disabled to
# give every other test the same server configuration on all versions.
!include include/default_my.cnf

[mysqld.1]
gtid-mode=OFF
enforce-gtid-consistency=OFF
