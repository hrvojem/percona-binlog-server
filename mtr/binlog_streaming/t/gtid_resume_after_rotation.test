#
# Checks that a binlog stored in GTID replication mode is an exact copy of the
# server's binlog when streaming resumes after the server rotated its binlog
# (e.g. 'FLUSH BINARY LOGS' from log rotation or a backup) and no new
# transaction was written to the previous binlog in the meantime.
#
# When resuming in GTID mode the server starts sending from the binlog that
# holds the first missing GTID, which is the newest binlog, so the ROTATE event
# that closes the previous binlog on the server is never received, and a
# binlog without transactions between the two (two rotations in a row) is
# never received at all. The stored copies must still match the server's
# binlogs: the first one ending with its ROTATE event, and the second one
# present.
#

--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

# in case of --repeat=N, we need to start from a fresh binary log to make
# this test deterministic
--echo *** Resetting replication at the very beginning of the test.
--disable_query_log
eval $stmt_reset_binary_logs_and_gtids;
--enable_query_log

--echo
--echo *** Determining the first binary log name.
--let $first_binlog = query_get_value($stmt_show_binary_log_status, File, 1)

# identifying backend storage type ('file' or 's3')
--source ../include/identify_storage_backend.inc

# creating data directory, configuration file, etc.
--let $binsrv_connect_timeout = 20
--let $binsrv_read_timeout = 60
--let $binsrv_idle_time = 10
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = gtid
--source ../include/set_up_binsrv_environment.inc

--echo
--echo *** Creating a simple table and filling it with some data.
CREATE TABLE t1(id INT UNSIGNED NOT NULL AUTO_INCREMENT, PRIMARY KEY(id)) ENGINE=InnoDB;
INSERT INTO t1 VALUES(DEFAULT);

--echo
--echo *** Executing the Binlog Server utility and fetching all events.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Flushing the first binary log and switching to the second one.
FLUSH BINARY LOGS;
--let $second_binlog = query_get_value($stmt_show_binary_log_status, File, 1)

--echo
--echo *** Flushing the second binary log (no transactions in it) and
--echo *** switching to the third one.
FLUSH BINARY LOGS;

--echo
--echo *** Filling the table with more data.
INSERT INTO t1 VALUES(DEFAULT);

--echo
--echo *** Executing the Binlog Server utility again to resume streaming.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Comparing the stored copies of the first and the second binary logs
--echo *** with the server's ones (closed, so they no longer have the "in use"
--echo *** flag).
if ($storage_backend == file)
{
  --diff_files $binlog_base_dir$first_binlog $binsrv_storage_path/$first_binlog
  --diff_files $binlog_base_dir$second_binlog $binsrv_storage_path/$second_binlog
}
if ($storage_backend == s3)
{
  --let $stored_binlog_copy = $MYSQL_TMP_DIR/stored_binlog
  --exec $aws_cli s3 cp s3://$aws_s3_bucket$binsrv_storage_path/$first_binlog $stored_binlog_copy > /dev/null
  --diff_files $binlog_base_dir$first_binlog $stored_binlog_copy
  --exec $aws_cli s3 cp s3://$aws_s3_bucket$binsrv_storage_path/$second_binlog $stored_binlog_copy > /dev/null
  --diff_files $binlog_base_dir$second_binlog $stored_binlog_copy
  --remove_file $stored_binlog_copy
}

--echo
--echo *** Dropping the table.
DROP TABLE t1;

# cleaning up
--source ../include/tear_down_binsrv_environment.inc
