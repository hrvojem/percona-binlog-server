# ==== Purpose ====
#
# Checks that the Binlog Server Utility in 'pull' mode (position-based
# replication) survives a source that is killed right after a rotation,
# before any transaction is written to the new binary log.
#
# PBS receives the ROTATE event and the new binary log's FORMAT_DESCRIPTION /
# PREVIOUS_GTIDS events, then loses the connection. When it reconnects, the
# restarted source re-sends those events followed by a ROTATE event to the
# binary log it created at startup. PBS must close the binary log left open
# and switch to the new one without tripping over the events it has buffered
# for it.
#
# This test:
#   1. starts PBS pulling from the source in position mode
#   2. rotates the binary log on the source and kills it within a second
#   3. restarts the source and waits for PBS to reconnect
#   4. checks that PBS is still running and keeps replicating: transactions
#      written after the restart reach the PBS storage
#   5. compares the binary logs stored by PBS with the source's ones.
#
# ==== References ====
#
# Ticket 6: pull aborts on 'Assertion incomplete_transaction_timestamps_.
#           is_empty()' in storage::open_binlog() after the source was killed
#           right after a rotation.

--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

--source include/count_sessions.inc

# in case of --repeat=N, we need to start from a fresh binary log to make
# this test deterministic
--echo *** Resetting replication at the very beginning of the test.
--disable_query_log
eval $stmt_reset_binary_logs_and_gtids;
--enable_query_log

# identifying backend storage type ('file' or 's3')
--source ../include/identify_storage_backend.inc

# A long read timeout keeps PBS from reconnecting while the source is idle,
# so that the only reconnect is the one caused by the killed source.
--let $binsrv_connect_timeout = 3
--let $binsrv_read_timeout = 60
--let $binsrv_idle_time = 1
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = position
--source ../include/set_up_auth_rsa_keys.inc
--source ../include/set_up_binsrv_environment.inc

--echo
--echo *** Determining the first binary log name.
--let $first_binlog = query_get_value($stmt_show_binary_log_status, File, 1)

--echo
--echo *** Creating a table and filling it with some data.
CREATE TABLE t1(id INT UNSIGNED NOT NULL AUTO_INCREMENT, PRIMARY KEY(id)) ENGINE=InnoDB;
INSERT INTO t1 VALUES(DEFAULT);

--echo
--echo *** Starting Binlog Server Utility in background in pull mode.
--let $binsrv_stderr_path = $MYSQL_TMP_DIR/binsrv_stderr.log
--let $proc_command_line = $BINSRV pull $binsrv_config_file_path > /dev/null 2> $binsrv_stderr_path
--let $proc_pid_file = $MYSQL_TMP_DIR/rs_source_killed_after_rotation_binsrv.pid
--source ../include/start_proc_in_background.inc
--let $binsrv_pid_file = $proc_pid_file

--echo
--echo *** Waiting for the replication source listener port ready to accept
--echo *** connections.
--let $listening_port = $binsrv_replication_source_port
--let $listening_host = 127.0.0.1
--source ../include/wait_for_listening_port.inc

--echo
--echo *** Waiting for PBS to start receiving the first binary log.
--let $max_number_of_attempts = 60
--let $iteration = 0
--let $grep_status = 1
while ($iteration < $max_number_of_attempts)
{
  --error 0, 1
  --exec grep --silent $first_binlog $binsrv_log_path
  --let $grep_status = $__error
  if ($grep_status == 0)
  {
    --let $iteration = $max_number_of_attempts
  }
  if ($grep_status != 0)
  {
    --sleep 1
    --inc $iteration
  }
}
if ($grep_status != 0)
{
  --die The Binlog Server Utility did not start receiving the first binary log.
}
--sleep 1

--echo
--echo *** Rotating the binary log on the source and killing the source before
--echo *** any transaction is written to the second binary log.
FLUSH BINARY LOGS;
--let $second_binlog = query_get_value($stmt_show_binary_log_status, File, 1)
# giving PBS the time to receive the ROTATE event and the second binary log's
# FORMAT_DESCRIPTION / PREVIOUS_GTIDS events
--sleep 1
--source include/kill_mysqld.inc

--echo
--echo *** Restarting the source: it starts the third binary log.
--sleep 2
--source include/start_mysqld.inc

--echo
--echo *** Determining the third binary log name.
--let $third_binlog = query_get_value($stmt_show_binary_log_status, File, 1)

--echo
--echo *** Adding rows and rotating, so that PBS closes the third binary log.
INSERT INTO t1 VALUES(DEFAULT);
INSERT INTO t1 VALUES(DEFAULT);
FLUSH BINARY LOGS;

--echo
--echo *** Determining the fourth binary log name.
--let $fourth_binlog = query_get_value($stmt_show_binary_log_status, File, 1)

--echo
--echo *** Waiting for PBS to switch to the fourth binary log, checking that it
--echo *** is still running meanwhile.
--let $max_number_of_attempts = 60
--let $iteration = 0
--let $grep_status = 1
--let $binsrv_running = 1
while ($iteration < $max_number_of_attempts)
{
  --error 0, 1
  --exec kill -0 `cat $binsrv_pid_file` 2>/dev/null
  --let $binsrv_kill_status = $__error
  if ($binsrv_kill_status != 0)
  {
    --let $binsrv_running = 0
    --let $iteration = $max_number_of_attempts
  }
  if ($binsrv_running)
  {
    --error 0, 1
    --exec grep --silent $fourth_binlog $binsrv_log_path
    --let $grep_status = $__error
    if ($grep_status == 0)
    {
      --let $iteration = $max_number_of_attempts
    }
    if ($grep_status != 0)
    {
      --sleep 1
      --inc $iteration
    }
  }
}
if (!$binsrv_running)
{
  --echo The Binlog Server Utility terminated unexpectedly. Its standard error:
  --cat_file $binsrv_stderr_path
  --die The Binlog Server Utility terminated after the source was killed right after a rotation.
}
if ($grep_status != 0)
{
  --die The Binlog Server Utility did not switch to the fourth binary log.
}

--echo
--echo *** Sending SIGTERM signal to the Binlog Server Utility and waiting
--echo *** for the process to terminate.
--let $proc_pid_file = $binsrv_pid_file
--source ../include/terminate_proc.inc

--echo
--echo *** Comparing server and stored versions of the first binary log.
--let $local_file = $binlog_base_dir/$first_binlog
--let $storage_object = $binsrv_storage_path/$first_binlog
--source ../include/diff_with_storage_object.inc

--echo
--echo *** Comparing server and stored versions of the second binary log (the
--echo *** one the source was killed in, holding no transactions).
--let $local_file = $binlog_base_dir/$second_binlog
--let $storage_object = $binsrv_storage_path/$second_binlog
--source ../include/diff_with_storage_object.inc

--echo
--echo *** Comparing server and stored versions of the third binary log (the
--echo *** transactions written after the restart).
--let $local_file = $binlog_base_dir/$third_binlog
--let $storage_object = $binsrv_storage_path/$third_binlog
--source ../include/diff_with_storage_object.inc

--remove_file $binsrv_stderr_path

--echo
--echo *** Dropping the table.
DROP TABLE t1;

# cleaning up
--source ../include/tear_down_binsrv_environment.inc

# As the Binlog Server Utility interrupts the connection upon termination,
# close it on the MySQL server side as well, so that MTR 'check-test' before
# and after the test produces the same output.
--source ../include/kill_binlog_dump_connection.inc

--source include/wait_until_count_sessions.inc
