#
# Checks that the Binlog Server utility reports a regular error, instead of
# crashing with a segmentation fault, when the binlog index of its storage is
# empty (e.g. after the storage was damaged), in the querying modes
# ('search_by_timestamp', 'search_by_gtid_set') and in the streaming mode
# ('fetch').
#

--source ../include/have_binsrv.inc

--source ../include/v80_v84_compatibility_defines.inc

# in case of --repeat=N, we need to start from a fresh binary log to make
# this test deterministic
--echo *** Resetting replication at the very beginning of the test.
--disable_query_log
eval $stmt_reset_binary_logs_and_gtids;
--enable_query_log

# identifying backend storage type ('file' or 's3')
--source ../include/identify_storage_backend.inc

# creating data directory, configuration file, etc.
--let $binsrv_connect_timeout = 20
--let $binsrv_read_timeout = 60
--let $binsrv_idle_time = 10
--let $binsrv_verify_checksum = TRUE
--let $binsrv_replication_mode = `SELECT IF(@@global.gtid_mode = 'ON', 'gtid', 'position')`
--source ../include/set_up_binsrv_environment.inc

--echo
--echo *** Creating a simple table and filling it with some data.
CREATE TABLE t1(id INT UNSIGNED NOT NULL AUTO_INCREMENT, PRIMARY KEY(id)) ENGINE=InnoDB;
INSERT INTO t1 VALUES(DEFAULT);

--echo
--echo *** Executing the Binlog Server utility and fetching all events.
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Emptying the binlog index in the storage.
--let $empty_file = $MYSQL_TMP_DIR/empty_binlog_index
--write_file $empty_file
EOF
if ($storage_backend == file)
{
  --remove_file $binsrv_storage_path/binlog.index
  --copy_file $empty_file $binsrv_storage_path/binlog.index
}
if ($storage_backend == s3)
{
  --exec $aws_cli s3 cp $empty_file s3://$aws_s3_bucket$binsrv_storage_path/binlog.index > /dev/null
}
--remove_file $empty_file

--let $read_from_file = $MYSQL_TMP_DIR/search_result.json

--echo
--echo *** Executing the Binlog Server utility in the 'search_by_timestamp'
--echo *** mode. It must fail with a regular error (exit code 1).
--error 1
--exec $BINSRV search_by_timestamp $binsrv_config_file_path 2026-10-06T00:00:00 > $read_from_file
--source include/read_file_to_var.inc
--assert(`SELECT JSON_EXTRACT('$result', '$.status') = 'error'`)

--echo
--echo *** Executing the Binlog Server utility in the 'search_by_gtid_set'
--echo *** mode. It must fail with a regular error (exit code 1).
--error 1
--exec $BINSRV search_by_gtid_set $binsrv_config_file_path 11111111-aaaa-1111-aaaa-111111111111:1 > $read_from_file
--source include/read_file_to_var.inc
--assert(`SELECT JSON_EXTRACT('$result', '$.status') = 'error'`)

--echo
--echo *** Executing the Binlog Server utility in the 'fetch' mode. It must
--echo *** fail with a regular error (exit code 1).
--error 1
--exec $BINSRV fetch $binsrv_config_file_path > /dev/null

--echo
--echo *** Removing the search result file.
--remove_file $read_from_file

--echo
--echo *** Dropping the table.
DROP TABLE t1;

# cleaning up
--source ../include/tear_down_binsrv_environment.inc
